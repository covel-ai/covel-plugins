{
  "name": "covel-plugin-directory",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm kit:check && node scripts/registry.mjs --check && node scripts/catalog/workflow.mjs && node scripts/catalog/theme.mjs",
    "generate": "node scripts/registry.mjs",
    "test": "pnpm run check:vendor && pnpm run test:registry && pnpm run test:plugins",
    "build:vendor": "node scripts/build-vendor.mjs",
    "test:registry": "node --test scripts/*.test.mjs examples/story-note/tests/*.test.js examples/notes-workbench/tests/*.test.js examples/note-format-clean/tests/*.test.js examples/note-format-outline/tests/*.test.js",
    "test:plugins": "vitest run",
    "check:vendor": "node scripts/build-vendor.mjs --check",
    "check:covel": "node scripts/check-covel.mjs",
    "test:catalog": "pnpm kit:check && pnpm --dir node_modules/@covel/catalog-kit test && node --test scripts/catalog/*.test.mjs",
    "collect": "node scripts/catalog/collect.mjs",
    "collect:local": "node scripts/catalog/collect.mjs --local",
    "build:site": "pnpm --filter @covel/directory-site build",
    "test:site": "playwright test",
    "build:pages": "pnpm build:site && node scripts/catalog/copy-pages.mjs",
    "kit:check": "node scripts/catalog-kit.mjs check && node scripts/catalog/check-installed-kit.mjs",
    "kit:sync": "node scripts/catalog-kit.mjs sync"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "semver": "^7.8.5",
    "vitest": "4.1.11",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@covel/catalog-kit": "file:vendor/catalog-kit"
  }
}
