{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Covel plugin directory entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "maintainer",
    "author",
    "repository",
    "path",
    "ref",
    "category",
    "locales",
    "license",
    "covelVersion",
    "status",
    "demo",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "maintainer": {
      "enum": [
        "official",
        "community"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
    },
    "path": {
      "type": "string",
      "pattern": "^([a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*)?$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "category": {
      "enum": [
        "narrative",
        "gameplay",
        "world",
        "media",
        "tools",
        "authoring"
      ]
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "license": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "covelVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "pending",
        "archived"
      ]
    },
    "demo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://"
    },
    "notes": {
      "type": "string"
    }
  }
}
