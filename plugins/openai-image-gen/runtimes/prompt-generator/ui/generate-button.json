{
  "id": "openai-image-gen-trigger",
  "group": "image-studio",
  "groupLabel": "Images",
  "groupOrder": 450,
  "label": "Generate",
  "icon": "wand",
  "alwaysRender": true,
  "view": {
    "component": "Stack",
    "props": {
      "gap": "sm"
    },
    "children": [
      {
        "component": "Card",
        "props": {
          "variant": "subtle"
        },
        "children": [
          {
            "component": "Stack",
            "props": {
              "gap": "xs"
            },
            "children": [
              {
                "component": "Text",
                "props": {
                  "content": "Story illustration",
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": "Click the button below to generate an image from the current story. Results appear in the gallery.",
                  "variant": "muted",
                  "size": "xs"
                }
              },
              {
                "component": "Button",
                "props": {
                  "label": "Generate image",
                  "variant": "primary",
                  "size": "md"
                },
                "on": {
                  "click": {
                    "action": "invokeRuntime",
                    "params": {
                      "runtimeId": "openai-image-gen/prompt-generator",
                      "expectsBackgroundFollower": true
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
