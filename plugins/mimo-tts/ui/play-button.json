{
  "id": "mimo-tts-speak-button",
  "group": "tts-studio",
  "groupLabel": "Narration",
  "groupOrder": 470,
  "label": "Speak",
  "icon": "mic",
  "view": {
    "component": "Card",
    "props": {
      "variant": "subtle"
    },
    "children": [
      {
        "component": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          {
            "component": "Icon",
            "props": {
              "name": "mic",
              "size": "sm"
            }
          },
          {
            "component": "Button",
            "props": {
              "label": "Speak this paragraph",
              "variant": "primary",
              "size": "compact"
            },
            "on": {
              "click": {
                "action": "invokeRuntime",
                "params": {
                  "runtimeId": "mimo-tts/manual-narrate",
                  "payload": {
                    "turnId": {
                      "$state": "/turnId"
                    },
                    "text": {
                      "$state": "/text"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
