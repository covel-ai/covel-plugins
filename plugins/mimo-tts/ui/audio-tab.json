{
  "id": "mimo-tts-audio-tab",
  "group": "tts-studio",
  "groupLabel": "Narration",
  "groupOrder": 470,
  "label": "Narration",
  "icon": "headphones",
  "alwaysRender": true,
  "dataSource": {
    "namespace": "tracks"
  },
  "emptyState": {
    "message": "No narration yet. Continue the story, or use the Speak button in the story area."
  },
  "view": {
    "component": "Stack",
    "props": {
      "gap": "lg"
    },
    "children": [
      {
        "component": "Stack",
        "repeat": {
          "statePath": "/entries",
          "key": "key"
        },
        "props": {
          "gap": "xs"
        },
        "children": [
          {
            "component": "Row",
            "props": {
              "gap": "sm",
              "align": "center"
            },
            "children": [
              {
                "component": "Icon",
                "props": {
                  "name": "headphones",
                  "size": "sm"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$item": "value/turnLabel"
                  },
                  "weight": "bold",
                  "size": "sm"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": {
                    "$item": "value/triggerLabel"
                  },
                  "color": "blue"
                }
              },
              {
                "component": "Badge",
                "props": {
                  "label": {
                    "$item": "value/voice"
                  },
                  "color": "purple"
                }
              },
              {
                "component": "Text",
                "props": {
                  "content": {
                    "$item": "value/sizeLabel"
                  },
                  "size": "xs",
                  "variant": "muted"
                }
              }
            ]
          },
          {
            "component": "Text",
            "props": {
              "content": {
                "$item": "value/textPreview"
              },
              "size": "xs",
              "variant": "muted"
            }
          },
          {
            "component": "AudioPlayer",
            "props": {
              "ref": {
                "$item": "value/ref"
              },
              "alt": {
                "$item": "value/textPreview"
              }
            }
          },
          {
            "component": "Separator"
          }
        ]
      }
    ]
  }
}
